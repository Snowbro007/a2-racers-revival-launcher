<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="A2 Racer II — Revival" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Width="1600" Height="900"
        Background="#131823" Foreground="#F5F6FA" FontFamily="Segoe UI"
        FontSize="23" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ForceCursor="True" Topmost="False">
  <Window.Resources>
    <LinearGradientBrush x:Key="Steel" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F0F2F7" Offset="0"/><GradientStop Color="#AEB8C9" Offset="0.12"/>
      <GradientStop Color="#D2D8E2" Offset="0.45"/><GradientStop Color="#ABB5C6" Offset="0.52"/>
      <GradientStop Color="#909CAF" Offset="0.92"/><GradientStop Color="#DFE3ED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelectedSteel" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#919BFF" Offset="0"/><GradientStop Color="#5D68D5" Offset="0.15"/>
      <GradientStop Color="#394C9D" Offset="0.85"/><GradientStop Color="#A1AEFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#626B7C" Offset="0"/><GradientStop Color="#454E60" Offset="0.48"/>
      <GradientStop Color="#323B4C" Offset="1"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="ClassicBackdrop" TileMode="Tile" Viewport="0,0,96,96" ViewportUnits="Absolute" Viewbox="0,0,96,96" ViewboxUnits="Absolute">
      <DrawingBrush.Drawing><DrawingGroup>
        <GeometryDrawing Brush="#21060B" Geometry="M0,0 L96,0 L96,96 L0,96 Z"/>
        <GeometryDrawing Brush="#391014" Geometry="M0,0 L20,0 L96,76 L96,96 L76,96 L0,20 Z"/>
        <GeometryDrawing Geometry="M0,48 L48,96 M48,0 L96,48"><GeometryDrawing.Pen><Pen Brush="#54131D" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing>
      </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
    <Style x:Key="GarageCard" TargetType="Border">
      <Setter Property="Background" Value="#263143"/><Setter Property="BorderBrush" Value="#AEB7C8"/>
      <Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F6FA"/>
      <Setter Property="Background" Value="#263247"/>
      <Setter Property="BorderBrush" Value="#748298"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="22,15"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="MinHeight" Value="62"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#394B69"/><Setter TargetName="Frame" Property="BorderBrush" Value="#A8B9FF"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D4DCFF"/><Setter TargetName="Frame" Property="BorderThickness" Value="3"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#4C5D99"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Steel}"/>
      <Setter Property="Foreground" Value="#98151C"/><Setter Property="FontSize" Value="23"/>
      <Setter Property="FontWeight" Value="Bold"/><Setter Property="BorderBrush" Value="#E1E5F0"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="22,12"/><Setter Property="MinHeight" Value="58"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#7084FF"/><Setter TargetName="Frame" Property="BorderThickness" Value="3"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D5DCFF"/><Setter TargetName="Frame" Property="BorderThickness" Value="3"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="ResetAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#80361F"/>
      <Setter Property="BorderBrush" Value="#F29A73"/>
      <Setter Property="Foreground" Value="#FFF5ED"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#B94A2E"/><Setter TargetName="Frame" Property="BorderBrush" Value="#FFD1A2"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFF5ED"/><Setter TargetName="Frame" Property="BorderThickness" Value="3"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#722415"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResetNav" TargetType="Button" BasedOn="{StaticResource ResetAction}">
      <Setter Property="FontSize" Value="22"/><Setter Property="Padding" Value="14,12"/>
      <Setter Property="MinHeight" Value="58"/><Setter Property="Margin" Value="0,12,0,10"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101927"/><Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="CaretBrush" Value="#FFFFFF"/><Setter Property="SelectionBrush" Value="#5C6FDA"/>
      <Setter Property="BorderBrush" Value="#647590"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/><Setter Property="FontSize" Value="26"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#111827"/><Setter Property="Background" Value="#ECF0F7"/>
      <Setter Property="FontSize" Value="24"/><Setter Property="Padding" Value="12"/>
      <Setter Property="MinHeight" Value="58"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#111827"/><Setter Property="Padding" Value="14,10"/></Style></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,10,0,20"/><Setter Property="FontSize" Value="23"/><Setter Property="Foreground" Value="#FFFFFF"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#F2E9CF"/><Setter Property="FontSize" Value="19"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="40"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,22"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.Background><StaticResource ResourceKey="ClassicBackdrop"/></Grid.Background>
    <Viewbox Stretch="Uniform">
      <Grid x:Name="Design" Width="1600" Height="900" Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Steel}" BorderBrush="#CED5E2" BorderThickness="0,1,0,2">
          <Grid Margin="36,0"><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="A2 RACER II" FontSize="39" FontWeight="Black" FontStyle="Italic" Foreground="#A7131A"/><TextBlock Text="R E V I V A L" FontSize="14" Foreground="#35415A" Margin="3,3,0,0"/></StackPanel>
            <TextBlock x:Name="Header" Text="HOOFDMENU" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="47" FontWeight="Black" FontStyle="Italic" Foreground="#AD141C"><TextBlock.Effect><DropShadowEffect Color="#101522" BlurRadius="1" ShadowDepth="1" Opacity="0.45"/></TextBlock.Effect></TextBlock>
            <Border Grid.Column="2" Background="#253247" BorderBrush="#B7C3D5" BorderThickness="1" CornerRadius="6" Padding="18,9" Margin="16,12,0,12">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="BESCHIKBAAR BUDGET" Foreground="#E5EAF4" FontSize="15"/>
                <TextBlock x:Name="HeaderBudget" Text="ƒ 35.000" Foreground="#FFE096" FontSize="32" FontWeight="Bold" Margin="0,1,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="28,26,28,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="278"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource Panel}" BorderBrush="#B7BECC" BorderThickness="3" CornerRadius="3" Padding="12">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom">
                <Button x:Name="NavReset" Content="Opnieuw beginnen" Style="{StaticResource ResetNav}" Tag="Reset"/>
                <Button x:Name="Quit" Content="AFSLUITEN" Style="{StaticResource Nav}" Margin="0,12,0,0"/>
                <TextBlock Text="Alt + F4 sluit alles" FontSize="17" Foreground="#F0F2F8" Margin="9,16,0,8"/>
              </StackPanel>
              <StackPanel>
                <Button x:Name="NavHome" Content="HOOFDMENU" Style="{StaticResource Nav}" Tag="Home"/>
                <Button x:Name="NavGarage" Content="GARAGE" Style="{StaticResource Nav}" Tag="Garage"/>
                <Button x:Name="NavCars" Content="SHOWROOM" Style="{StaticResource Nav}" Tag="Cars"/>
                <Button x:Name="NavControls" Content="BESTURING" Style="{StaticResource Nav}" Tag="Controls"/>
                <Button x:Name="NavOptions" Content="OPTIES" Style="{StaticResource Nav}" Tag="Options"/>
                <Button x:Name="NavRecords" Content="RECORDS" Style="{StaticResource Nav}" Tag="Records"/>
                <Button x:Name="NavPlayers" Content="SPELERS" Style="{StaticResource Nav}" Tag="Players"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid Grid.Column="2">
            <Grid x:Name="HomeView">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="22"/><RowDefinition Height="187"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
              <Border Background="{StaticResource Panel}" BorderBrush="#B8C0CF" BorderThickness="2" CornerRadius="3" Padding="28">
                <StackPanel>
                  <TextBlock Text="SPELERINFORMATIE" Style="{StaticResource Caption}"/>
                  <TextBlock Text="Jouw naam" Foreground="#F0F2F8" Margin="0,8,0,8"/>
                  <TextBox x:Name="PlayerName" MaxLength="24" AutomationProperties.Name="Spelersnaam"/>
                  <Button x:Name="SaveName" Content="Naam opslaan" Margin="0,12,0,14"/>
                  <Border Background="#101E30" BorderBrush="#647A98" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,16">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Jouw budget" Foreground="#DCE6F6" FontSize="22" VerticalAlignment="Center"/><TextBlock x:Name="Money" Grid.Column="1" HorizontalAlignment="Right" FontSize="31" FontWeight="Bold" Foreground="#FFE096" Text="ƒ 35.000"/></Grid>
                  </Border>
                  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Schade" Foreground="#E4E8F0"/><TextBlock x:Name="Damage" Grid.Column="1" HorizontalAlignment="Right" Text="0%"/></Grid>
                  <ProgressBar x:Name="DamageBar" Value="0" Maximum="100" Height="12" Background="#101826" Foreground="#5BDBA2" BorderThickness="0"/>
                  <TextBlock x:Name="CampaignProgress" Text="Voltooi de eerste race om de volgende etappe te ontgrendelen" TextWrapping="Wrap" FontSize="18" Foreground="#E4E8F0" Margin="0,16,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#B8C0CF" BorderThickness="2" CornerRadius="3" Padding="28">
                <Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="63"/></Grid.RowDefinitions>
                  <StackPanel><TextBlock Text="JOUW AUTO" Style="{StaticResource Caption}"/><TextBlock x:Name="CarName" Text="Brabant" FontSize="31" FontWeight="SemiBold"/></StackPanel>
                  <Grid Grid.Row="1" ClipToBounds="True"><Ellipse Height="35" Width="310" Fill="#65000000" VerticalAlignment="Bottom" Margin="0,0,0,25"/><Viewport3D x:Name="CarViewport" IsHitTestVisible="False"/></Grid>
                  <Button x:Name="HomeGarage" Grid.Row="2" Content="Auto en onderdelen bekijken  →" Margin="0" HorizontalContentAlignment="Center"/>
                </Grid>
              </Border>
              <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource Panel}" BorderBrush="#B8C0CF" BorderThickness="2" CornerRadius="3" Padding="26">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="KIES JE ETAPPE" Style="{StaticResource Caption}"/><ComboBox x:Name="TrackChoice" DisplayMemberPath="name" SelectedValuePath="id" AutomationProperties.Name="Etappe"/><TextBlock x:Name="TrackDescription" Text="Stedenrace · 2 ronden" FontSize="18" Foreground="#E4E8F0" Margin="0,11,0,0"/></StackPanel>
                  <Button x:Name="StartRace" Grid.Column="2" Content="START RACE  →" Background="#5365E5" BorderBrush="#AEBBFF" FontSize="32" HorizontalContentAlignment="Center" Margin="0,16,0,16"/>
                </Grid>
              </Border>
            </Grid>
            <Border x:Name="DetailView" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="#B8C0CF" BorderThickness="2" CornerRadius="3" Padding="32">
              <Grid><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="DetailTitle" Text="Garage" Style="{StaticResource PageTitle}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="DetailContent" Margin="0,0,16,12"/></ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="342,0,35,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="Status" Text="Klaar voor de start." FontSize="18" Foreground="#D3DCEC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="Tab · Enter · Esc terug" FontSize="17" Foreground="#9FADC5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</Window>

    <LinearGradientBrush x:Key="ChromeText" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#E4EAF5" Offset="0.43"/>
      <GradientStop Color="#8390AB" Offset="0.5"/><GradientStop Color="#F8FAFF" Offset="0.61"/>
      <GradientStop Color="#BCC9E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueSign" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#1264BF" Offset="0"/><GradientStop Color="#094892" Offset="0.48"/>
      <GradientStop Color="#083677" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="Button">
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Background" Value="#152A49"/>
      <Setter Property="BorderBrush" Value="#3E597B"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <Border x:Name="FocusRing" CornerRadius="6" BorderBrush="#FFFFFF" BorderThickness="1" Margin="4" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Border x:Name="HoverLight" CornerRadius="6" Background="#0DFFFFFF" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLight" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RoadSignButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource BlueSign}"/><Setter Property="BorderThickness" Value="3"/>
      <Setter Property="Padding" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="118"/>
    </Style>
    <Style x:Key="ProfileButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1B334E"/><Setter Property="BorderBrush" Value="#718FAE"/>
      <Setter Property="Padding" Value="11,7"/><Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style x:Key="SetupChoiceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#163B60"/><Setter Property="BorderBrush" Value="#7299C2"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/>
      <Setter Property="MinHeight" Value="60"/>
    </Style>
    <Style x:Key="SetupHelpButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#213149"/><Setter Property="BorderBrush" Value="#566F8A"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Margin" Value="0,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="Box" Width="18" Height="18" Background="#0A1630" BorderBrush="#6684AB" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Left">
            <Path x:Name="Tick" Data="M2,8 L6,12 13,3" Stroke="#FFE057" StrokeThickness="2.5" Visibility="Collapsed"/>
          </Border>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
        </Grid><ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="#FFE057"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#203D67"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="Padding" Value="12,10"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" Background="#132744"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1E5187"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFE057"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#78879B"/><Setter Property="Opacity" Value="0.48"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECF2FA"/><Setter Property="MinHeight" Value="42"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#132744" BorderBrush="#45658E" BorderThickness="1" CornerRadius="5">
            <Path Data="M0,0 L5,5 10,0" Stroke="#FFE057" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
          </Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="13,9,36,9"/>
        <Border x:Name="ComboFocus" BorderBrush="White" BorderThickness="1" CornerRadius="5" Margin="3" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
          <Border BorderBrush="#6684AB" BorderThickness="1" Background="#132744" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
            <ScrollViewer MaxHeight="270"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid><ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#A9B9D4"/><Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,3" BorderBrush="Transparent">
          <ContentPresenter ContentSource="Header"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="TabSurface" Property="Background" Value="#14263F"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFE057"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="#FFE057"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#203652"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/></Style>
    <Style x:Key="OverviewCard" TargetType="Border">
      <Setter Property="Background" Value="#172638"/><Setter Property="BorderBrush" Value="#34485E"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="70"/>
    </Style>
    <Style x:Key="OverviewLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A9BDD5"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="OverviewValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F4F7FD"/><Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="#152334"/><Setter Property="BorderBrush" Value="#33465B"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,15"/><Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="CategoryHeading" TargetType="Label">
      <Setter Property="Foreground" Value="#F4F7FD"/><Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="11,0,0,1"/>
      <Setter Property="Margin" Value="0,0,0,15"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Label">
        <Border BorderBrush="#FFE057" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
          <ContentPresenter RecognizesAccessKey="True"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F4F7FD"/><Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="OptionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D7E2F2"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="OptionNote" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A6B8CE"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="17"/>
      <Setter Property="Margin" Value="0,7,0,0"/>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#D7E2F2"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="ExpandHeader" IsChecked="{Binding IsExpanded,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" Background="#14253F" BorderBrush="#314662" Foreground="#D7E2F2">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ExpandSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="13,9">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center"/>
                <Path x:Name="ExpandArrow" Grid.Column="1" Data="M0,0 L5,5 10,0" Stroke="#C9D8EC" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid></Border><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ExpandSurface" Property="Background" Value="#203D60"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ExpandSurface" Property="BorderBrush" Value="White"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ExpandArrow" Property="Data" Value="M0,5 L5,0 10,5"/></Trigger>
              </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
            <ContentPresenter Content="{TemplateBinding Header}"/>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" ContentSource="Content" Margin="0,14,0,0" Visibility="Collapsed"/>
        </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.Background><SolidColorBrush Color="#0D1521"/></Grid.Background>
    <Image x:Name="CoverBackdrop" Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0.26"/>
    <Border Background="#CF0D1521" IsHitTestVisible="False"/>
    <Grid Margin="26,22,26,18">
      <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image x:Name="LauncherBadge" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1" Margin="0,0,0,0">
          <TextBlock Text="A2 Racers Revival" FontFamily="Bahnschrift" FontSize="32" FontWeight="Bold" FontStyle="Italic" Foreground="{StaticResource ChromeText}"/>
          <TextBlock Text="Game launcher" Foreground="#A6B8CE" FontSize="12" Margin="1,4,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" Background="#182537" BorderBrush="#33465B" BorderThickness="1" CornerRadius="5" Padding="11,6" VerticalAlignment="Top" Margin="0,8,0,0">
          <TextBlock Text="Windows · Singleplayer" Foreground="#A6B8CE" FontSize="11"/>
        </Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="BIBLIOTHEEK" FontSize="11" Foreground="#A6B8CE" FontWeight="SemiBold" Margin="3,2,0,14"/>
          <Button x:Name="GameOne" Grid.Row="1" Style="{StaticResource RoadSignButton}" BorderBrush="#FFDD4A" Margin="0,0,0,12" AutomationProperties.Name="A2 Racer I selecteren">
            <Border BorderBrush="#AFCDE7" BorderThickness="1" CornerRadius="2" Padding="12,11">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="I" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="43" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="A2 Racer I" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="21"/>
                  <TextBlock x:Name="GameOneAvailability" Text="Wordt gecontroleerd" FontSize="12" Foreground="#D3E5FA" Margin="0,4,0,0"/>
                  <TextBlock x:Name="GameOneSelected" Text="Geselecteerd" FontSize="11" FontWeight="SemiBold" Foreground="#FFE66D" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </Button>
          <Button x:Name="GameTwo" Grid.Row="2" Style="{StaticResource RoadSignButton}" BorderBrush="#356E95" AutomationProperties.Name="A2 Racer II selecteren">
            <Border BorderBrush="#AFCDE7" BorderThickness="1" CornerRadius="2" Padding="12,11">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="II" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="36" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="A2 Racer II" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="21"/>
                  <TextBlock x:Name="GameTwoAvailability" Text="Wordt gecontroleerd" FontSize="12" Foreground="#D3E5FA" Margin="0,4,0,0"/>
                  <TextBlock x:Name="GameTwoSelected" Text="Geselecteerd" FontSize="11" FontWeight="SemiBold" Foreground="#FFE66D" Margin="0,8,0,0" Visibility="Hidden"/>
                </StackPanel>
              </Grid>
            </Border>
          </Button>
          <Button x:Name="GameThree" Grid.Row="3" Style="{StaticResource RoadSignButton}" BorderBrush="#356E95" Margin="0,12,0,0" AutomationProperties.Name="A2 Racer III voorbereiding bekijken">
            <Border BorderBrush="#AFCDE7" BorderThickness="1" CornerRadius="2" Padding="12,11">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="III" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="36" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="A2 Racer III" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="21"/>
                  <TextBlock Text="In ontwikkeling" FontSize="12" Foreground="#D3E5FA" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>
          </Button>
          <Border Grid.Row="5" Background="#C9152334" BorderBrush="#33465B" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,15,0,0"><StackPanel>
            <TextBlock Text="Kies je game" Foreground="#D7E2F2" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="Elke game heeft eigen instellingen." TextWrapping="Wrap" Foreground="#A6B8CE" FontSize="11" LineHeight="17" Margin="0,5,0,0"/>
          </StackPanel></Border>
        </Grid>
        <Border Grid.Column="2" CornerRadius="10" Background="#F5111D2C" BorderBrush="#33465B" BorderThickness="1" Padding="24,20,24,18">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
              <Button x:Name="OpenGameLibrary" Content="Gamebestandenmap openen" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SetupHelpButton}" Margin="16,0,0,0" ToolTip="Opent de map voor je eigen gamekopie. Games worden niet meegeleverd of automatisch geïmporteerd."/>
              <StackPanel>
              <TextBlock x:Name="GameTitle" Text="A2 Racer I" FontFamily="Bahnschrift" FontWeight="SemiBold" FontSize="30"/>
              <TextBlock x:Name="GameSubtitle" Text="Revived-instellingen voor A2 Racer I." Foreground="#A6B8CE" TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,5,0,0"/>
              </StackPanel>
            </DockPanel>
            <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,10,0,0" Foreground="#F2F4FB">
              <TabItem Header="Spelen"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="StartScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,1,8,0">
                  <Border Background="#19283D" BorderBrush="#526C8B" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" ClipToBounds="True">
                    <Grid Height="104"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Image x:Name="CoverPreview" Stretch="UniformToFill" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="A2-sfeerbeeld met een auto op de snelweg"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,8,16,8">
                        <TextBlock x:Name="WelcomeTitle" Text="Welkom bij A2 Racers Revival" Foreground="#FFE66D" FontFamily="Bahnschrift" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="WelcomeHint" Text="De launcher wordt geopend. Games zijn niet inbegrepen; je kunt straks je eigen gamemap of ZIP-bestand toevoegen." Foreground="#E0E9F6" FontSize="12" TextWrapping="Wrap" LineHeight="17" Margin="0,5,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border x:Name="InstallationPanel" Visibility="Collapsed" Background="#233147" BorderBrush="#FFE057" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14"><StackPanel>
                    <TextBlock x:Name="InstallationTitle" Text="Stap 1 · Voeg je eigen A2 Racer I toe" FontSize="18" FontWeight="SemiBold" Foreground="#FFF1BD"/>
                    <TextBlock x:Name="InstallationNote" Text="Kies hoe je je eigen volledige Nederlandse game hebt opgeslagen. Je bron blijft intact." TextWrapping="Wrap" FontSize="12" Foreground="#D7E2F2" Margin="0,5,0,8"/>

                <Expander Header="Support · voorbereiding" Foreground="#C4D5EA" Margin="0,0,0,12"><Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><StackPanel>
                  <TextBlock x:Name="IIIStatus" FontSize="13" TextWrapping="Wrap"/>
                  <TextBlock Text="Menu, bediening, audio, Alt+Tab en voortgang moeten nog worden getest. Debug en tweak mode blijven uit." Style="{StaticResource OptionNote}"/>
                </StackPanel></Border></Expander>
              </StackPanel></ScrollViewer></TabItem>
            </TabControl>
            <Border Grid.Row="2" BorderBrush="#33465B" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock x:Name="StatusTitle" Text="Launcher openen…" Foreground="#C4D5EA" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock x:Name="StatusMessage" MaxHeight="36" TextTrimming="CharacterEllipsis" Text="De launcherbasis wordt klaargezet. Je hoeft nog geen game te hebben toegevoegd." Foreground="#A6B8CE" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,5,0,0"/>
                  <Button x:Name="SupportDetails" Content="Details bekijken bij Support" Visibility="Collapsed" HorizontalAlignment="Left" Padding="0,5,0,0" Background="Transparent" BorderThickness="0" Foreground="#B7CBDF" FontSize="11"/>
                </StackPanel>
                <Button x:Name="PlayButton" Grid.Column="1" Content="Speel A2 Racer I" BorderBrush="#FFE057" Foreground="#142038" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" IsEnabled="False" Padding="15,15">
                  <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFE66D" Offset="0"/><GradientStop Color="#EFC339" Offset="1"/></LinearGradientBrush></Button.Background>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>
      <TextBlock Grid.Row="2" Text="A2 RACERS REVIVAL" FontSize="9" Foreground="#8097B0" VerticalAlignment="Bottom"/>
    </Grid>
  </Grid>
</Window>
